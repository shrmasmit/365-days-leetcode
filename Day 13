Accepted ✔️

##Code

#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

class Solution {
public:

    void nextPermutation(vector<int>& nums) {

        int n = nums.size();

        // Step 1: Find pivot
        int i = n - 2;

        while (i >= 0 && nums[i] >= nums[i + 1]) {
            i--;
        }

        // Step 2: Find successor
        if (i >= 0) {

            int j = n - 1;

            while (nums[j] <= nums[i]) {
                j--;
            }

            // Step 3: Swap
            swap(nums[i], nums[j]);
        }

        // Step 4: Reverse suffix
        reverse(nums.begin() + i + 1, nums.end());
    }
};

int main() {

    Solution obj;

    vector<int> nums = {1, 2, 3};

    obj.nextPermutation(nums);

    cout << "Next Permutation: ";

    for (int x : nums) {
        cout << x << " ";
    }

    cout << endl;

    return 0;
}
